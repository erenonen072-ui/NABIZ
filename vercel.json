{
  "cleanUrls": true,
  "trailingSlash": true,
  "rewrites": [
    {
      "source": "/haberler/:slug/",
      "destination": "/haberler/:slug.html"
    },
    {
      "source": "/haberler/:slug",
      "destination": "/haberler/:slug.html"
    },
    {
      "source": "/haber/:slug/",
      "destination": "/haberler/:slug.html"
    },
    {
      "source": "/haber/:slug",
      "destination": "/haberler/:slug.html"
    }
  ]
}
